{
  "hosting": {
    "public": "dist/site",
    "ignore": ["firebase.json", "**/.*", "**/*.bak"],
    "cleanUrls": true,
    "headers": [
      { "source": "**", "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" } ] },
      { "source": "**/*.@(html|json|js|webmanifest)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
      { "source": "**/*.@(png|svg)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ] },
      { "source": "/admin", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ] }
    ]
  }
}
